# QUANTFORGE environment configuration (Phases 4 & 6).
#
# QUANTFORGE does not auto-load a .env file — export these in your shell or
# set them via your process manager. This file documents what exists.

# ---- AI advisory layer (src/ai/) -------------------------------------------
# Provider: anthropic | openai | openrouter | stub.
# Default is "stub": a deterministic offline placeholder that clearly labels
# its output and needs no key — the whole Phase 4 surface works without one.
# Any real provider with a missing AI_API_KEY also falls back to the stub,
# as does any individual call that fails with a network/auth error.
AI_PROVIDER=stub

# Model id, per provider. Defaults if unset:
#   anthropic  -> claude-opus-4-8        (Messages API)
#   openai     -> gpt-4o-mini            (Chat Completions API)
#   openrouter -> anthropic/claude-sonnet-4.5   (OpenAI-compatible API; use
#                 OpenRouter's own model catalog naming)
AI_MODEL=

# API key for the chosen real provider. Leave empty to run on the stub.
AI_API_KEY=

# Optional API origin override (no trailing /v1) — mainly useful for
# openrouter or a local proxy, e.g. https://openrouter.ai/api
AI_BASE_URL=

# ---- Worker (src/worker/index.js) ------------------------------------------
# AI daily brief interval in ms. Default 86400000 (24h) for real deployment;
# set it short (e.g. 5000) to watch the brief fire in a demo.
QF_BRIEF_MS=86400000

# Other worker knobs (defaults in src/worker/index.js):
#   QF_DB_PATH, QF_SETTLE_MS, QF_SNAPSHOT_MS, QF_CONFIDENCE_MS, QF_STALE_MS,
#   QF_FEE_BPS, QF_SLIPPAGE_BPS

# ---- Live execution (Phase 6, src/live/index.js) ----------------------------
# SAFETY: the default for everything below is a PURE DRY-RUN — the live
# runner journals the orders it WOULD place (live_orders table) and touches
# no exchange and no funds. The only real adapter targets the Binance SPOT
# TESTNET; there is deliberately NO mainnet value and NO mainnet code path.

# 'dry_run' (default) or 'testnet'. Any other value falls back to dry_run.
# 'testnet' only takes effect once a portfolio's mandatory dry-run window
# has elapsed AND both testnet keys are set AND every per-order gate passes.
QF_LIVE_MODE=dry_run

# Mandatory dry-run window: hours of wall-clock time after promotion before
# testnet placement is allowed for that portfolio (portfolios.dry_run_started_at).
QF_DRY_RUN_HOURS=48

# Binance SPOT TESTNET credentials (https://testnet.binance.vision).
# These are TESTNET keys — mainnet keys are useless here by design: the
# adapter verifies every resolved endpoint is a testnet URL and refuses
# to place otherwise. Leave empty to keep the testnet path unreachable.
QF_BINANCE_TESTNET_KEY=
QF_BINANCE_TESTNET_SECRET=

# Circuit breakers (testnet-small defaults; see src/live/executor.js):
# per-order notional ceiling, max estimated risk per trade as a percent of
# live capital, and max open live exposures per portfolio.
QF_MAX_ORDER_NOTIONAL=500
QF_PER_TRADE_RISK_PCT=1
QF_MAX_CONCURRENT=3

# How often the live runner polls for new paper orders to mirror, ms.
QF_LIVE_POLL_MS=5000
