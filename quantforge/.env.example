# QUANTFORGE environment configuration (Phase 4).
#
# QUANTFORGE does not auto-load a .env file — export these in your shell or
# set them via your process manager. This file documents what exists.

# ---- AI advisory layer (src/ai/) -------------------------------------------
# Provider: anthropic | openai | openrouter | stub.
# Default is "stub": a deterministic offline placeholder that clearly labels
# its output and needs no key — the whole Phase 4 surface works without one.
# Any real provider with a missing AI_API_KEY also falls back to the stub,
# as does any individual call that fails with a network/auth error.
AI_PROVIDER=stub

# Model id, per provider. Defaults if unset:
#   anthropic  -> claude-opus-4-8        (Messages API)
#   openai     -> gpt-4o-mini            (Chat Completions API)
#   openrouter -> anthropic/claude-sonnet-4.5   (OpenAI-compatible API; use
#                 OpenRouter's own model catalog naming)
AI_MODEL=

# API key for the chosen real provider. Leave empty to run on the stub.
AI_API_KEY=

# Optional API origin override (no trailing /v1) — mainly useful for
# openrouter or a local proxy, e.g. https://openrouter.ai/api
AI_BASE_URL=

# ---- Worker (src/worker/index.js) ------------------------------------------
# AI daily brief interval in ms. Default 86400000 (24h) for real deployment;
# set it short (e.g. 5000) to watch the brief fire in a demo.
QF_BRIEF_MS=86400000

# Other worker knobs (defaults in src/worker/index.js):
#   QF_DB_PATH, QF_SETTLE_MS, QF_SNAPSHOT_MS, QF_CONFIDENCE_MS, QF_STALE_MS,
#   QF_FEE_BPS, QF_SLIPPAGE_BPS
