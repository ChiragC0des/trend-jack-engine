# Trend-Jack Ad Engine — Environment Configuration
# Copy this to .env and fill in credentials

# --- AI PROVIDER (google or openai) ---
PROVIDER=google

# --- GOOGLE GEMINI (default, recommended) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=***
# For Imagen image generation (set PROVIDER=google):
GOOGLE_IMAGE_MODEL=imagen-3.0-generate-002
# Alternative: gemini-2.5-flash-image for Nano Banana (faster, cheaper)

# --- OPENAI (fallback) ---
OPENAI_API_KEY=***
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# --- TELEGRAM ---
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- REDDIT API ---
# Create at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret

# --- BRANDING ---
BRAND_TEXT=seepmedia.ai

# --- PIPELINE SETTINGS ---
MIN_AD_SCORE=7
AUTO_PUBLISH=false
